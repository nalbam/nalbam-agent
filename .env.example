# ─────────────────────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────────────────────

# Generate with: openssl rand -base64 32
# Minimum 32 characters. Without this, getServerEnv() throws.
BETTER_AUTH_SECRET=

# ─────────────────────────────────────────────────────────────
# Better Auth (server)
# ─────────────────────────────────────────────────────────────

# Public URL the auth server is reachable at. Defaults to http://localhost:3000.
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated list of additional origins allowed to call the auth API
# (in addition to BETTER_AUTH_URL). Required for production with custom domains.
# TRUSTED_ORIGINS="https://app.example.com,https://admin.example.com"

# ─────────────────────────────────────────────────────────────
# Better Auth (client)
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Next.js Tailwind Starter"

# Toggle the email/password form on /login and /signup. Defaults to enabled;
# set to "false" to hide it entirely (server also disables emailAndPassword).
# NEXT_PUBLIC_AUTH_EMAIL_ENABLED="true"

# Set to "true" to render the "Continue with Google" button on /login and /signup.
# The server still requires AUTH_GOOGLE_ID and AUTH_GOOGLE_SECRET to actually accept
# the redirect; set both to enable end-to-end.
# NEXT_PUBLIC_AUTH_GOOGLE_ENABLED="true"

# ─────────────────────────────────────────────────────────────
# AWS
# ─────────────────────────────────────────────────────────────

AWS_REGION="ap-northeast-2"

# Local development uses the default AWS credential chain
# (~/.aws/credentials, AWS_PROFILE, IAM Identity Center / SSO, etc.).
# Leave the two below unset locally. In Amplify Hosting, attach an IAM
# role to the SSR compute role instead of shipping static keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────
# DynamoDB
# ─────────────────────────────────────────────────────────────

DYNAMODB_TABLE_NAME="app-main"

# Both local development AND production talk to real AWS DynamoDB by default.
# Provision the table once with `pnpm db:init` (uses your local AWS creds).
#
# Set DYNAMODB_ENDPOINT ONLY when pointing at DynamoDB Local (e.g., for the
# integration test profile: `docker compose --profile test up -d`). Leave it
# unset for real-AWS development.
# DYNAMODB_ENDPOINT="http://localhost:8000"

# ─────────────────────────────────────────────────────────────
# Session/rate-limit KV (Better Auth secondaryStorage)
# ─────────────────────────────────────────────────────────────

# Local development: Valkey via docker-compose (`docker compose up -d valkey`).
REDIS_URL="redis://localhost:6379"

# Production (Amplify): use Upstash Redis REST. If both are set, Upstash wins.
# UPSTASH_REDIS_REST_URL="https://<your-instance>.upstash.io"
# UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────
# Auth methods (optional)
# ─────────────────────────────────────────────────────────────

# Toggle the email/password sign-in path server-side. Defaults to enabled.
# Set to "false" to disable Better Auth's emailAndPassword provider.
# AUTH_EMAIL_ENABLED="true"

# Google OAuth client. Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# ─────────────────────────────────────────────────────────────
# Transactional email (optional)
# ─────────────────────────────────────────────────────────────

# Verified sender for AWS SES. When set, src/lib/email.ts uses SES via the
# default AWS credential chain (Amplify SSR compute role recommended).
# Leave empty for a console-only fallback in dev.
# AWS_SES_FROM="no-reply@example.com"

# ─────────────────────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────────────────────

# Optional. One of: debug, info, warn, error. Defaults: dev=debug, prod=info.
# LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# Slack bot (multi-tenant)
# ─────────────────────────────────────────────────────────────
# Per-app Slack secrets live in SSM Parameter Store at:
#   {SLACK_SSM_PREFIX}/{api_app_id}/signing_secret  (SecureString)
#   {SLACK_SSM_PREFIX}/{api_app_id}/bot_token       (SecureString)
# App metadata (team_id, ACL, persona) lives in DynamoDB.
# SLACK_SSM_PREFIX="/nalbam-agent/slack/apps"
# SLACK_SSM_CACHE_TTL_SECONDS=300

# ─────────────────────────────────────────────────────────────
# LLM / agent
# ─────────────────────────────────────────────────────────────
# Text provider/model. One of: openai, bedrock.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# Image generation provider/model. Defaults to LLM_PROVIDER when unset.
# IMAGE_PROVIDER=openai
# IMAGE_MODEL=gpt-image-1
# OPENAI_API_KEY=sk-...
# TAVILY_API_KEY=tvly-...
# AGENT_MAX_STEPS=6
# MAX_OUTPUT_TOKENS=4096
# RESPONSE_LANGUAGE=ko
# Operator policy appended to base task rules. Global only (no per-app override).
# SYSTEM_MESSAGE=
# Persona/tone. Per-app override may replace this via DynamoDB.
# PERSONA_MESSAGE=

# ─────────────────────────────────────────────────────────────
# Slack rendering / behavior
# ─────────────────────────────────────────────────────────────
# BOT_CURSOR=":robot_face:"
# Per-message char cap. Long answers are split hierarchically.
# MAX_LEN_SLACK=3000
# Per-thread serialized conversation history cap.
# MAX_HISTORY_CHARS=4000
# Comma-separated channel allowlist. Empty = all allowed. Per-app override in DDB.
# ALLOWED_CHANNEL_IDS=
# ALLOWED_CHANNEL_MESSAGE="질문은 {} 채널을 이용해 주세요~"
# Comma-separated user allowlist. Empty = all allowed. Per-app override in DDB.
# ALLOWED_USER_IDS=
# ALLOWED_USER_MESSAGE="허용된 유저만 응답합니다."
# Per-user concurrent active request cap (throttle).
# MAX_THROTTLE_COUNT=100

# ─────────────────────────────────────────────────────────────
# Documents / web extraction
# ─────────────────────────────────────────────────────────────
# DEFAULT_TIMEZONE="Asia/Seoul"
# MAX_DOC_CHARS=20000
# MAX_DOC_PAGES=50
# MAX_DOC_BYTES=26214400          # 25 MB
# MAX_WEB_CHARS=8000
# MAX_WEB_BYTES=2097152           # 2 MB
# MAX_WEB_LINKS=20
# MAX_IMAGE_BYTES=10485760        # 10 MB
# JINA_READER_BASE="https://r.jina.ai"
